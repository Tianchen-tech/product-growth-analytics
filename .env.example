# Google Cloud project used to run queries and host the analytical views.
BQ_PROJECT_ID=your-google-cloud-project-id

# BigQuery datasets referenced by this project are in the US multi-region.
BQ_LOCATION=US

# The runner creates this dataset when `setup` is run.
BQ_DATASET_ID=product_growth_analytics

# Per-query safety ceiling. Ten decimal GB is comfortably above the current
# public-sample scans while preventing an accidental unbounded query.
BQ_MAX_BYTES_BILLED=10000000000
